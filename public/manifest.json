{
  "manifest_version": 3,
  "name": "qBits",
  "version": "1.0.0",
  "description": "Monitor your qBitorrents",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png",
      "256": "icon-256.png",
      "512": "icon-512.png"
    },
    "default_title": "qBits",
    "default_popup": "popup.html"
  },
  "permissions": ["contextMenus", "storage", "declarativeNetRequestWithHostAccess", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "index.html"
}
